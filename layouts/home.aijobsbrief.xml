{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $count := 0 -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>AI Jobs Brief | Income For Everyone</title>
    <link>{{ site.BaseURL }}</link>
    <description>Daily sourced stories on AI, jobs, labor data, and income security.</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- range $pages.ByDate.Reverse }}
      {{- if and (findRE `^\d{4}-\d{2}-\d{2}$` .File.BaseFileName) (lt $count 30) }}
        {{- $count = add $count 1 }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ .Summary | plainify }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>
    </item>
      {{- end }}
    {{- end }}
  </channel>
</rss>
